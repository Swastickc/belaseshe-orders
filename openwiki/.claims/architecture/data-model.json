        }
      ]
    },
    {
      "id": "claim_05f7903781694ed9b4fb5d5f6ce551d3",
      "statement": "Contrary to the file's own header comment claiming items and total are frozen after creation, isValidStatusUpdate's hasOnly list includes items and total, so the rules allow rewriting an existing order's items and total.",
