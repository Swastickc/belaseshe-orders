    {
      "id": "claim_f1d59e0964764dd383a613114550b4fb",
      "statement": "Firestore is the only backend: the three HTML pages talk to it directly from the browser via the Firebase JS SDK, with no server and no authentication layer; the database defines exactly two collections, orders/{orderId} and config/{docId}.",
      "evidence": [
        {
          "resource": "repo://firestore.rules#L24-L39",
          "version": "repo-lines-v1:sha256:1d7a3018f88c12f9a4dafc0230d54ff46879716d9e1190839bbe970fc3fc9e45:"
        },
        {
          "resource": "repo://shared/firebase-config.js#L1-L20",
          "version": "repo-lines-v1:sha256:c383375eb28e24c8bac577cf479db8315ff66e0b4a23e670fba87c108506d4fa:"
        }
      ]
    },
    {
      "id": "claim_6e21870c46b043c19041971a6e401d29",
      "statement": "Order documents are created client-side with the creator encoded in the id prefix and source field: the customer menu writes ids prefixed c_ with source 'customer' and seen false, while the staff app writes ids prefixed o_ with source 'staff' and seen true.",
      "evidence": [
        {
          "resource": "repo://index.html#L1089-L1107",
          "version": "repo-lines-v1:sha256:4047212ade9bf6dc7890f46ba13aefcf6253a551c44a078f94f7ef55ece12d82:"
        },
        {
          "resource": "repo://menu.html#L633-L652",
