        }
      ]
    },
    {
      "id": "claim_155b7183b15f4212b81ebf66104e1061",
      "statement": "A new order can only be created through the rules if it has the required keys, a valid destination (table|takeaway), a valid zone (rooftop|downstairs|none), between 1 and 40 items, a numeric total between 0 and 100000, status exactly 'pending', and source 'staff' or 'customer' — so an order can never be created already paid.",
      "evidence": [
        {
          "resource": "repo://firestore.rules#L41-L49",
          "version": "repo-lines-v1:sha256:9d7f5258d4fc82086bca508a4550faef18863848d5ecf86097ab2128a416bc0b:"
        }
      ]
    },
    {
      "id": "claim_ed170f132450490d80547cafa146b4e7",
      "statement": "The order status lifecycle is pending → preparing → ready → paid; update validation restricts changed keys to status, updatedAt, note, seen, items, and total, and the customer's live status tracker folds ready and paid onto the same final step.",
      "evidence": [
        {
          "resource": "repo://firestore.rules#L51-L55",
          "version": "repo-lines-v1:sha256:75586ecaaa0a3702ecba2d60e08e5b2f57fdca0d689159c3fb0a57a654c5c84b:"
        },
